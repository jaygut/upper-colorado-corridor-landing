{
  "$schema": "graph-of-life/brand-tokens/1.0",
  "brand": "Graph of Life",
  "version": "1.0.0",
  "ethos": "prove less, more carefully",
  "note": "Single source of truth. No agent may emit a colour, font, or size that is not resolvable from this file. Where prose guidance and this file disagree, this file wins.",

  "color": {
    "ink": {
      "navy":   { "hex": "#0E2A47", "role": "primary ink, dark covers, table headers, KPI bands" },
      "abyss":  { "hex": "#08203A", "role": "depth, layered dark grounds, footers" },
      "slate":  { "hex": "#243B4A", "role": "body text on light" },
      "muted":  { "hex": "#5C6E78", "role": "secondary text, captions, provenance" }
    },
    "accent": {
      "teal":   { "bright": "#1AA89B", "deep": "#0E7A70", "meaning": "connection / edges",           "aa_on_white": "deep", "contrast_deep": 5.2 },
      "green":  { "bright": "#3AD6A3", "deep": "#0F8059", "meaning": "living capital / data signal", "aa_on_white": "deep", "contrast_deep": 4.9 },
      "coral":  { "bright": "#E8694D", "deep": "#C2442A", "meaning": "risk / fragility / keystone",  "aa_on_white": "deep", "contrast_deep": 5.1 },
      "amber":  { "bright": "#F2A24E", "deep": "#A86410", "meaning": "caution / medium risk tier",   "aa_on_white": "deep", "contrast_deep": 4.7 }
    },
    "ground": {
      "sand":     { "hex": "#E9E1CC", "role": "warm fills, pull-quotes, caveat callouts" },
      "paper":    { "hex": "#F7F6F2", "role": "page ground, warm off-white, never stark white" },
      "bone":     { "hex": "#FBFAF6", "role": "card ground, table zebra" },
      "mist":     { "hex": "#EAF1F1", "role": "cool callout fill, insight" },
      "hairline": { "hex": "#D7DEE2", "role": "borders, rules" }
    },
    "budget": {
      "navy_and_neutrals": 0.70,
      "teal": 0.20,
      "green": 0.07,
      "coral_and_amber": 0.03,
      "rule": "If coral is everywhere it means nothing. Coral is scarce by design."
    },
    "risk_scale": {
      "order": ["low", "medium", "high"],
      "low":    { "bright": "#3AD6A3", "deep": "#0F8059" },
      "medium": { "bright": "#F2A24E", "deep": "#A86410" },
      "high":   { "bright": "#E8694D", "deep": "#C2442A" },
      "note": "Green -> Amber -> Coral. TNFD-friendly. Never invert."
    },
    "allowlist": [
      "#0E2A47", "#08203A", "#243B4A", "#5C6E78",
      "#1AA89B", "#0E7A70", "#3AD6A3", "#0F8059",
      "#E8694D", "#C2442A", "#F2A24E", "#A86410",
      "#E9E1CC", "#F7F6F2", "#FBFAF6", "#EAF1F1", "#D7DEE2",
      "#FFFFFF", "#000000"
    ]
  },

  "type": {
    "families": {
      "sans": {
        "primary": "IBM Plex Sans",
        "stack": "'IBM Plex Sans', Aptos, Calibri, Arial, sans-serif",
        "office_fallback": ["Aptos", "Calibri", "Arial"],
        "use": "display, headings, body, labels"
      },
      "mono": {
        "primary": "IBM Plex Mono",
        "stack": "'IBM Plex Mono', Consolas, 'Cascadia Mono', monospace",
        "office_fallback": ["Consolas", "Cascadia Mono"],
        "use": "the proof voice: every metric, unit, source, DOI, eyebrow, code"
      },
      "serif": null,
      "serif_note": "The system is all-sans. There is no serif in this brand."
    },
    "mono_test": "If a reader could fact-check it (a number, a unit, a source, a date, an ID), set it in mono. Everything else is sans.",
    "scale": {
      "display":    { "size_px": [44, 72], "weight": 700, "tracking_em": -0.025, "leading": 1.05, "family": "sans" },
      "h1":         { "size_px": [30, 40], "weight": 700, "tracking_em": -0.02,  "leading": 1.15, "family": "sans" },
      "h2":         { "size_px": [22, 26], "weight": 600, "tracking_em": -0.01,  "leading": 1.25, "family": "sans", "color": "navy", "rule": "hairline above in documents" },
      "body":       { "size_px": [16, 16], "weight": 400, "leading": 1.65, "family": "sans", "color": "slate", "max_measure_ch": 68 },
      "eyebrow":    { "size_px": [12, 12], "weight": 500, "tracking_em": 0.16, "family": "mono", "transform": "uppercase", "color": "teal", "lead_glyph": "\u25CF" },
      "metric":     { "weight": 600, "family": "mono", "figures": "tabular-nums", "color_on_dark": "green.bright", "color_on_light": "green.deep or navy", "rule": "always show units" },
      "provenance": { "size_px": [11, 12], "weight": 400, "family": "mono", "color": "muted", "format": "SOURCE \u00B7 METHOD \u00B7 CONFIDENCE \u00B7 USE" },
      "caption":    { "size_px": [13, 13], "weight": 400, "family": "sans", "color": "muted" }
    }
  },

  "geometry": {
    "derived": true,
    "derived_note": "Values below are derived to make the stated system reproducible across agents. They are consistent with the brand but were not in the original prose spec.",
    "space_base_px": 8,
    "space_scale_px": [4, 8, 16, 24, 32, 48, 64, 96],
    "radius_px": { "default": 2, "card": 2, "chip": 999, "note": "Structural system. No soft/rounded UI except risk chips." },
    "rules": {
      "hairline_px": 1,
      "teal_rule_px": 2,
      "coral_rule_px": 1,
      "callout_left_rule_px": 3,
      "spine_bar_px": 6
    },
    "slide": {
      "aspect": "16:9",
      "size_in": [13.333, 7.5],
      "margin_pct": 0.06,
      "margin_in": 0.8,
      "edge_tab_in": [0.55, 0.11]
    },
    "document": {
      "ground": "paper",
      "columns": 1,
      "max_measure_ch": 68,
      "margin_in": [1.0, 1.0, 1.0, 1.0]
    },
    "motif_opacity": { "ambient_edge": 0.14, "ambient_node": 0.22, "divider_edge": 0.55 }
  },

  "logo": {
    "type": "node-edge glyph + wordmark",
    "pictorial_mascot": false,
    "glyph_nodes": [
      { "name": "connection", "token": "teal" },
      { "name": "signal", "token": "green" },
      { "name": "keystone_at_risk", "token": "coral" },
      { "name": "structure", "token": "navy_or_paper_by_ground" }
    ],
    "clearspace": ">= glyph height",
    "min_wordmark": { "mm": 28, "px": 110 },
    "on_dark": "bright tones",
    "on_light": "deep tones"
  },

  "architecture": {
    "master": "Graph of Life",
    "products": ["AI Ecologist", "Poseidon", "Nereus", "Rizon", "HiGEBCA", "GeaMesh"],
    "product_rule": "Products share the entire house system. No product gets its own palette or font. Distinguished only by name plus an optional one-word descriptor.",
    "cobrand_rule": "Co-branded vehicles (e.g. Blue Finance Intelligence) sit beside the wordmark, never replace it.",
    "product_cover": "Master mark small top-left, product name as title, footer reads: A Graph of Life platform \u00B7 graphoflife.com"
  }
}
